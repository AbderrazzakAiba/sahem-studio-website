# Copy to .env.local (never commit .env.local). Only NEXT_PUBLIC_* values reach the browser.

# Public URL of the site (used for canonical links, hreflang and Open Graph images).
# Optional: on Vercel it defaults to the project's production address; set it when the real domain is live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Start form delivery (server only, never NEXT_PUBLIC). Set these in Vercel › Settings › Environment Variables.
# A brief goes to every configured channel; with none, nothing is sent (the server logs "preview mode").

# Telegram: the bot token (@BotFather, secret), the group id (-100…) and the id of the "طلبات" topic.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# Email through Resend.
RESEND_API_KEY=
# Optional: where briefs go (defaults to the studio email) and the sender once the domain is verified in Resend.
BRIEF_TO=
BRIEF_FROM=
